function gpx(c) {
  const name = `Big C ${Math.round(c.ev.dist / 1000)} km ${compass(c.outBrg)}`;
  let s = `<?xml version="1.0" encoding="UTF-8"?>\n<gpx version="1.1" creator="Big C 2.0 wind optimizer" xmlns="http://www.topografix.com/GPX/1/1">\n` +
    `  <metadata><name>${esc(name)}</name></metadata>\n  <trk><name>${esc(name)}</name><type>cycling</type><trkseg>\n`;
  // no duplicate or near-duplicate points (some importers reject them): keep points at least 10 m apart
  const kept = c.pts.filter((p, i, a) => i === 0 || i === a.length - 1 || hav(a[i - 1][0], a[i - 1][1], p[0], p[1]) >= 0.5);
  let lastKept = null;
  kept.forEach((p, i) => {
    if (lastKept && i !== kept.length - 1 && hav(lastKept[0], lastKept[1], p[0], p[1]) < 10) return;
    lastKept = p;
    const ele = p[2] != null ? `<ele>${p[2].toFixed(1)}</ele>` : "";
    s += `    <trkpt lat="${p[0].toFixed(6)}" lon="${p[1].toFixed(6)}">${ele}</trkpt>\n`;
  });
