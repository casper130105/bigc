    const r = homeDir != null && it.kind === "fsw" ? reach * FSW_REACH : reach;
    let d = Infinity;
    for (const q of it.samp) { const dd = hav(p[0], p[1], q[0], q[1]); if (dd < d) d = dd; }
    if (d > r) continue;
    const al = Math.cos((it.brg - tangent) * D2R);
    if (Math.abs(al) < 0.6) continue;
    if (avoid && it.samp.some(q => inCellIndex(avoid, q[0], q[1], 150))) continue;
    const ride = al < 0 ? norm(it.brg + 180) : it.brg;
    let sc = it.pop + 0.6 * Math.abs(al) - d / r + Math.min(it.len, 4000) / 8000, pink = false;
    if (homeDir != null) {
