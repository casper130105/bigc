   Requests that can also go to OSRM (exploring) skip BRouter while it rests instead of waiting for it. */
const brRest = () => { brLane.strikes = Math.min(brLane.strikes + 1, 4); brLane.restUntil = Date.now() + Math.min(12000, 4000 * 2 ** (brLane.strikes - 1)); };
