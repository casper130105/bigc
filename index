/* Progress bar: each stage owns a share of the bar, weighted by how long it usually takes */
const STAGES = [["geo", "Start", .04], ["wind", "Wind", .06], ["data", "Loading roads", .30], ["route", "Routing", .55], ["pick", "Picking the winner", .05]];
const prog = {
  start() {
    this.t0 = Date.now(); $("#prog").hidden = false; $("#prog").classList.remove("done", "ended", "long"); $("#steps").innerHTML = "";
    clearInterval(this.timer);
    this.ext = null;
    this.timer = setInterval(() => {
      const s = Math.floor((Date.now() - this.t0) / 1000);
      $("#progTime").textContent = this.ext ? `${s} / ${Math.round((this.ext - this.t0) / 1000)} s` : `${s} s`;
      if (this.ext) { // past the normal 30 s: the bar runs on the clock towards the 60 s limit
        const pct = Math.min(99, Math.max(this.pct, Math.round(100 * (Date.now() - this.t0) / (this.ext - this.t0))));
        this.pct = pct; $("#progFill").style.width = pct + "%"; $("#progBar").setAttribute("aria-valuenow", pct); $("#progPct").textContent = pct + "%";
      }
    }, 250);
    this.set("geo", 0);
  },
  set(stage, frac, label) {
    let base = 0, w = 0;
    for (const [id, , wt] of STAGES) { if (id === stage) { w = wt; break; } base += wt; }
    const pct = Math.round(100 * (base + w * Math.min(1, Math.max(0, frac))));
    if (!this.ext && (pct >= (this.pct || 0) || stage === "geo")) this.pct = pct; // never move backwards; past 30 s the clock drives it
    $("#progFill").style.width = this.pct + "%";
    $("#progBar").setAttribute("aria-valuenow", this.pct);
    $("#progPct").textContent = this.pct + "%";
    $("#progLabel").textContent = label || STAGES.find(x => x[0] === stage)[1];
  },
  extend(until) { // the plan needs more time: the bar rescales to the new limit and says why
    this.ext = until;
    this.pct = Math.round(100 * (Date.now() - this.t0) / (until - this.t0));
    $("#progFill").style.width = this.pct + "%"; $("#progPct").textContent = this.pct + "%";
    $("#prog").classList.add("long");
    $("#progLabel").textContent = "Needs a bit longer: up to 60 s";
  },
  note(text, state = "done") { diag.push("notes", [diag.s(), state[0], String(text).slice(0, 120)], 50); }, // for the problem code only: the result card says what matters
  finish(ok, label) {
    clearInterval(this.timer);
    const secs = ((Date.now() - this.t0) / 1000).toFixed(1);
    $("#progTime").textContent = `${secs} s`;
