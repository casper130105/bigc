    } };
    await exploreRounds();
    if (!results.some(isClean)) { // nothing good yet: search on, up to 60 s in all
      extendTime("Not found yet: taking up to 60 s for a good loop");
      EXPLORE_BY = DEADLINE - 15000;
      await exploreRounds();
    }
    if (!results.length) throw failWith("no-loop", "The routing server didn't return a route in time. It's a free service and may be busy; try again in a minute.");
    prog.note(`${requests} routes requested, ${results.filter(isClean).length} good loops of ${results.length}`);

    prog.set("pick", 0);
    say("Checking surfaces and distance of the best loops…");
    // a pink loop (tailwind home on a fietssnelweg) always wins when one exists that is
    // close to the asked distance and doesn't repeat roads; otherwise the best wind loop wins
    const pinkOk = r => r.pinkLen >= 1000 && Math.abs(r.ev.dist / target - 1) < 0.12 && r.repScored / r.ev.dist < 0.05;
    // never show a loop with headwind on the way home. Real roads wiggle (roundabouts, turns),
    // so a loop passes if at most 2% of the way home is headwind and no headwind stretch is longer than 200 m
    // margin tiers: no headwind home (allowing roundabouts and turns), then up to 5 %, then up to 10 %.
    // Only loops from the strictest tier that has any are shown; if even 10 % fails, the 3 cleanest are shown.
    // repeats after the start: if any clean loop exists, loops with more than 200 m of them are dropped
    if (results.some(r => r.repAfter < 200)) { const before = results.length; results.splice(0, results.length, ...results.filter(r => r.repAfter < 200)); if (before > results.length) prog.note(`${before - results.length} with repeated roads hidden`, "skip"); }
    // headwind on the way home, in tiers: 0 = none (≤2 %, allowing roundabouts and turns), 1 = ≤5 %, 2 = ≤10 %, 3 = more
    const TIERS = [[2, 300], [5, 500], [10, 1000]]; // [% of the way home, longest stretch m]; 300 m covers a roundabout or a bend
    results.concat(quietRes).forEach(r => { r.tier = TIERS.findIndex(T => r.ev.hdBack <= T[0] && r.ev.homeHeadRun <= T[1]); if (r.tier < 0) r.tier = 3; });
    const bestTier = Math.min(...results.map(r => r.tier));
    if (bestTier > 0) prog.note(`No loop without headwind home today: ${Math.round(Math.min(...results.map(r => r.ev.hdBack)))}% is the least`, "skip");
    const hidden = results.filter(r => r.tier > Math.max(bestTier, 1)).length;
    if (hidden) prog.note(`${hidden} with headwind home hidden`, "skip");
    // distance: every route shown is within ±5 % of the asked distance. Explored loops close to it go first; the
    // final paved re-route below rescales a loop (up to 3 times) until it fits, or moves on to the next candidate.
    const TOL = 0.05, off = r => Math.abs(r.ev.dist / target - 1), within = r => off(r) <= TOL;
    // loops already routed by BRouter with the right profile and length need no extra request: they go first among equals
    const ready = r => (r.src === "paved" || (r.src === "quiet" && r.quiet)) && within(r);
    const ordered = (list, key) => list.filter(r => off(r) <= 0.12).sort((a, b) => (within(b) - within(a)) || (ready(b) - ready(a)) || key(a, b));
    const keyOf = r => `${r.hdg}${r.shape}${r.side}${r.reversed ? "r" : ""}${r.quiet ? "q" : ""}`;
    // option 1: from the cleanest tier, the way home that points straightest downwind (tailwind angle × distance)
    // (minus a penalty for strong headwind on the way out, so a loop that tacks out beats one that fights the wind head-on)
    const value = r => r.ev.homeAlign - 0.6 * r.ev.hardOutFrac;
    let straightList = ordered(results.filter(r => r.tier === bestTier), (a, b) => (value(b) - value(a)) || (a.score - b.score));
    if (!straightList.length) { // nothing close to the distance: resize the closest loops (the way out is rescaled in finalise)
      straightList = results.concat(quietRes).filter(r => off(r) <= 0.45 && r.repAfter < 1000).sort((a, b) => (a.tier - b.tier) || (off(a) - off(b)));
      if (straightList.length) prog.note("No loop close to the distance yet: resizing the closest", "skip");
    }
    const fswTierMax = Math.max(bestTier, 1);
    // every route shown is routed by the paved-only profile in its own direction of travel, and must end up within ±5 %
    // (explored routes may come from OSRM, which can't avoid unpaved roads, or be scored reversed)
    const finalise = async (w0, DEADLINE = PLAN_DEADLINE) => {
      if (!w0) return null;
      const prof = w0.quiet ? "quiet" : "paved";
      if (w0.src === prof && within(w0) && !(w0.detour && w0.detour.excess > 300)) return w0;
      let scale = w0.scale, b = w0.b, best = null, detourFixed = false;
      const ban = []; // waypoints that caused a detour stay out when the way out is resized
      const keep = (bb, test) => { // drop the out waypoints (never the join point) for which test() is true
        const j = bb.nOut - 1, wps = bb.wps.filter((w, k) => k === j || k > j || !test(w));
        return wps.length === bb.wps.length ? null : { ...bb, wps, nOut: bb.nOut - (bb.wps.length - wps.length) };
      };
      const banned = w => ban.some(p => hav(p.lat, p.lon, w.lat, w.lon) < 400);
      const detourWps = (re, bb) => keep(bb, w => { // a waypoint whose nearest route point lies inside a detour
        let bi = -1, bd = 300;
        for (let i = 0; i < re.pts.length; i += 2) { const d = hav(w.lat, w.lon, re.pts[i][0], re.pts[i][1]); if (d < bd) { bd = d; bi = i; } }
        return bi >= 0 && re.detour.list.some(([a, z]) => bi > a && bi < z);
      });
      const tries = []; // [scale, km] of every re-route: once one is too long and one too short, the next scale is
                        // interpolated between them (snapping to roads makes the length jump, so plain rescaling overshoots)
      for (let attempt = 0; attempt < 3 && DEADLINE - Date.now() > 2500; attempt++) {
        try {
          const pts = await brouterReq([home, ...b.wps, home], prof, DEADLINE);
          const re = process(pts, b, { hdg: w0.hdg, shape: w0.shape, side: w0.side, n: w0.n, scale, homeLen: w0.homeLen, leg: w0.leg, quiet: w0.quiet, src: pts.src, unpavedM: pts.unpaved });
          if (re.detour.excess > 300 && !detourFixed) { // a waypoint pulled the route around a block: drop it and route again
            const nb = detourWps(re, b);
            diag.push("fin", [keyOf(w0), attempt, km1(w0.ev.dist), km1(re.ev.dist), "detour " + Math.round(re.detour.excess) + " m", nb ? "drop " + (b.wps.length - nb.wps.length) + " wp" : "no wp to drop", diag.s()], 40);
            if (nb) { detourFixed = true; ban.push(...b.wps.filter(w => !nb.wps.includes(w))); b = nb; attempt--; continue; }
          }
          // the loop changed character: clearly more headwind home, or clearly more road ridden twice
          const changed = re.ev.hdBack > Math.max(3, 1.5 * w0.ev.hdBack + 2) || re.repAfter > Math.max(500, 1.5 * w0.repAfter + 500);
          if (within(re) && re.ev.hdBack <= 10) fitPool.push(re); // last resort: any loop of the right length
          // distance fix: [loop, try, km before, km after, % headwind home, repeat m, result, s]
          diag.push("fin", [keyOf(w0), attempt, km1(w0.ev.dist), km1(re.ev.dist), r1(re.ev.hdBack), Math.round(re.repAfter), changed ? "changed" : within(re) ? "fits" : "resize", diag.s()], 40);
          if (changed) break;
          re.tier = TIERS.findIndex(T => re.ev.hdBack <= T[0] && re.ev.homeHeadRun <= T[1]); if (re.tier < 0) re.tier = 3;
          if (!best || off(re) < off(best)) best = re;
          if (within(re)) return re;
          tries.push([scale, re.ev.dist]);
          const over = tries.filter(t => t[1] > target).sort((x, y) => x[1] - y[1])[0], under = tries.filter(t => t[1] < target).sort((x, y) => y[1] - x[1])[0];
          if (over && under) scale = under[0] + (over[0] - under[0]) * (target - under[1]) / (over[1] - under[1]);
          else { const outLen = Math.max(2000, re.ev.dist - w0.homeLen); scale *= (outLen + target - re.ev.dist) / outLen; } // resize only the way out
          b = outFor(w0.leg, w0.side, scale, w0.n, !!w0.quiet);
          if (ban.length) b = keep(b, banned) || b;
        } catch (e) { serverFailed.add(w0); diag.push("fin", [keyOf(w0), attempt, km1(w0.ev.dist), "fail", diag.ekey(e), diag.s()], 40); console.warn("paved re-route failed", e); break; }
      }
      if (DEADLINE - Date.now() <= 2500) diag.push("fin", [keyOf(w0), "out of time", diag.s()], 40);
      return best && within(best) ? best : null;
    };
    const finMemo = new Map(); // a candidate is finalised at most once
    const fitPool = [];
    const serverFailed = new Set(); // loops whose length fix failed only because the server refused: worth another try
    const firstThatFits = async (list, accept, maxReroute = 3) => {
      let rerouted = 0;
      for (const c of list.slice(0, 8)) {
        if (DEADLINE - Date.now() < 2500) break;
        if (!accept(c)) continue;
        const k = keyOf(c) + "|" + Math.round((c.scale || 1) * 100) + "|" + c.n;
        if (!finMemo.has(k)) {
          if (!ready(c) && ++rerouted > maxReroute) break; // limit the candidates that need re-routing per option
          finMemo.set(k, await finalise(c));
        }
        const f = finMemo.get(k);
        if (f && accept(f)) return f;
      }
      return null;
    };
    let optA = await firstThatFits(straightList, () => true, 6); // option 1 must always appear: more tries
    if (!optA) extendTime("Fitting the distance: taking up to 60 s");
    if (!optA && DEADLINE - Date.now() > 3500) { // none of those fit: every other loop gets a turn, closest to the distance first,
      // and the ones that only failed because the server refused get another go
      for (const [k, v] of finMemo) if (v === null) { const c = results.concat(quietRes).find(r => keyOf(r) + "|" + Math.round((r.scale || 1) * 100) + "|" + r.n === k); if (c && serverFailed.has(c)) finMemo.delete(k); }
      const rest = results.concat(quietRes).filter(r => (!straightList.slice(0, 8).includes(r) || serverFailed.has(r)) && off(r) <= 0.45 && r.repAfter < 10000)
        .sort((a, b) => (a.tier - b.tier) || (off(a) - off(b)));
      if (rest.length) { prog.note("Resizing more loops to fit the distance", "skip"); optA = await firstThatFits(rest, () => true, 8); }
    }
    if (!optA && fitPool.length) { // never "no route" when a loop of the right length was routed: the cleanest one, repeats shown
      optA = fitPool.sort((a, b) => (a.tier - b.tier) || (a.repAfter - b.repAfter) || (off(a) - off(b)))[0];
      if (optA.repAfter >= 150) prog.note(`Not enough roads here for a loop without repeats: ${(optA.repAfter / 1000).toFixed(1)} km is ridden twice`, "skip");
    }
    if (!optA) { // the paved-roads server never answered in time: show the best explored loop of the right length, marked
                 // "Surface not checked" on its card, rather than nothing
      const unchecked = results.concat(quietRes).filter(r => within(r) && r.repAfter < 3000 && r.tier <= 2).sort((a, b) => (a.tier - b.tier) || (a.repAfter - b.repAfter) || (value(b) - value(a)))[0];
      if (unchecked) { optA = unchecked; prog.note("The paved-roads server was busy: check the surface before you ride", "skip"); }
    }
    if (!optA) throw failWith("no-fit", `Couldn't fit a loop within 5% of ${Math.round(target / 1000)} km in time. Try again, or a slightly different distance.`);
    const straight = optA;
    // option 2: the best loop home on a fietssnelweg with tailwind; it may take one tier more headwind (≤5 %), and it must
    // ride clearly more fietssnelweg with tailwind home than option 1 (at least 1 km more)
    let altLabel = "Via fietssnelweg";
    const fswList = ordered(results.filter(r => pinkOk(r) && r.tier <= fswTierMax), (a, b) => (Math.round((b.pinkLen - a.pinkLen) / 500)) || (a.tier - b.tier) || (value(b) - value(a)));
    let optB = await firstThatFits(fswList, r => keyOf(r) !== keyOf(optA) && r.pinkLen >= optA.pinkLen + 1000);
    // option 3 (before any "Alternative", which matters less): the loop with the least time in towns (villages count a
    // quarter, the first and last 3 km don't count). Same rules as the others (±5 %, no repeated roads, paved, headwind
    // home at most one tier worse than option 1), and only shown if it saves at least 5 minutes in town.
    const cmp = r => r && r.ev.busy ? r.ev.busy.cmpSec : Infinity;
    const refSec = Math.min(cmp(optA), cmp(optB));
    let optC = null;
    const pickC = async () => {
      const shown = [optA, optB].filter(Boolean).map(keyOf);
      const quietList = ordered(quietRes.concat(results.filter(r => r.ev.busy)).filter(r => r.tier <= fswTierMax && r.repAfter < 400),
        (a, b) => (Math.round((cmp(a) - cmp(b)) / 60)) || (value(b) - value(a)));
      return firstThatFits(quietList, r => !shown.includes(keyOf(r)) && cmp(r) <= refSec - 300 && (r.repAfter < 300 || !within(r)));
    };
    if (isFinite(refSec) && refSec > 300) {
      optC = await pickC();
      // nothing quieter yet: use the time left for quiet loops with other ways home (each way home passes different
      // places), then pick again
      if (!optC && DEADLINE - Date.now() > 7000) {
        say("Looking for a quieter way around the towns…");
        const tried = new Set(quietRes.map(q => q.leg.dirT + "|" + q.side));
        const extra = [];
        for (const L of kept.concat(legs.filter(legOk))) for (const side of [1, -1]) {
          const k = L.dirT + "|" + side;
          if (!tried.has(k) && L.J && extra.length < 3) { tried.add(k); extra.push([L, side]); }
        }
        for (const [L, side] of extra) {
          if (DEADLINE - Date.now() < 5000) break;
          try {
            const b = outFor(L, side, 1, m, true);
            if (tooWet(L, side, b, 1, m, true)) continue;
            const pts = await brouterReq([home, ...b.wps, home], "quiet", DEADLINE - 3000);
            const c = process(pts, b, { hdg: L.dirT, shape: "quiet", side, n: m, scale: 1, homeLen: homeAfterJ(L), leg: L, quiet: true, src: pts.src, unpavedM: pts.unpaved });
            c.tier = TIERS.findIndex(T => c.ev.hdBack <= T[0] && c.ev.homeHeadRun <= T[1]); if (c.tier < 0) c.tier = 3;
            quietRes.push(c);
          } catch (e) { console.warn("extra quiet loop failed", e); }
        }
        if (DEADLINE - Date.now() > 2500) optC = await pickC();
      }
      if (optC) optC.label = "Fewest towns";
      else prog.note("No loop with clearly less town riding today", "skip");
    }
    if (!optB) {
      // no separate fietssnelweg loop: offer the next-best clearly different loop, so there are still two choices
      altLabel = "Alternative";
      const altList = ordered(results.filter(r => r.tier <= fswTierMax), (a, b) => (a.tier - b.tier) || (value(b) - value(a)));
      const taken = [optA, optC].filter(Boolean);
      optB = await firstThatFits(altList, r => taken.every(t => keyOf(r) !== keyOf(t) && Math.abs(((r.outBrg - t.outBrg) % 360 + 540) % 360 - 180) > 20));
    }
    // only show an option if it is the best at something; an option that is best at several things gets a combined
    // label. Categories: wind (straight downwind home, minus strong headwind out), fietssnelweg (km with tailwind home,
    // at least 1 km) and towns (built-up time, villages a quarter). Near-equal values count as a tie, and a tie goes to
    // an option that already wins something, so no near-identical options are shown.
    const cand = [...new Set([optA, optB, optC].filter(Boolean))];
    const wins = new Map(cand.map(c => [c, []]));
    const cats = [
      { name: "Best wind", score: c => value(c) - 0.05 * (c.tier || 0), tol: 0.02, ok: () => true }, // headwind home counts against
      { name: "Most fietssnelweg", score: c => c.pinkLen / 1000, tol: 0.5, ok: c => c.pinkLen >= 1000 },
      { name: "Fewest towns", score: c => c.ev.busy ? -c.ev.busy.cmpSec / 60 : -Infinity, tol: 2, ok: c => !!c.ev.busy },
    ];
    for (const cat of cats) {
      const pool = cand.filter(cat.ok);
      if (!pool.length) continue;
      const top = Math.max(...pool.map(cat.score));
      const near = pool.filter(c => cat.score(c) >= top - cat.tol);
      const winner = near.find(c => wins.get(c).length) || near.sort((a, b) => cat.score(b) - cat.score(a))[0];
      wins.get(winner).push(cat.name);
    }
    const best = cand.filter(c => wins.get(c).length);
    best.forEach(c => { const w = wins.get(c); c.label = w.length === 1 ? w[0] : w.map((x, i) => i ? x.charAt(0).toLowerCase() + x.slice(1) : x).join(" · "); });
    const merged = cand.length - best.length;
    if (merged) prog.note(`${merged} option${merged === 1 ? "" : "s"} left out: not the best at anything`, "skip");
    if (!best.some(c => c.pinkLen >= 1000) && fswOnly.length) prog.note("No fietssnelweg with tailwind home today", "skip");
    best.forEach(c => c.desc = `Wind ${Math.round(ws * 3.6)} km/h from ${compass(wd)} at ${new Date(start).toLocaleString()}. Est. ${fmtTime(c.ev.time)} at ${rider.power} W.`);
    state.cands = best; state.sel = 0;
    // every loop that is ready to ride (paved, right length, no repeats, headwind home in an accepted tier) is kept for
    // the priority sliders, so they can re-rank without a new search
    // loops for the priority sliders: ready ones (paved, ±5 %) first, then close ones (±12 %) that get checked
    // (re-routed once, about 2 s) only when a slider picks them
    const readyPool = [];
    const failedKeys = new Set([...finMemo.entries()].filter(([, v]) => !v).map(([k]) => k.split("|")[0]));
    for (const c of [...best, ...finMemo.values(), ...results, ...quietRes]) {
      if (!c || c.repAfter >= (c.quiet ? 300 : 200) || (c.tier ?? 3) > fswTierMax || off(c) > 0.12) continue;
      if (!ready(c) && failedKeys.has(keyOf(c))) continue; // already tried at the end and it didn't fit
      c.cells = c.cells || cellsOf(c.pts);
      c.ready = ready(c);
      const twin = readyPool.findIndex(r => r === c || overlap(r.cells, c.cells) > 0.92);
      if (twin >= 0) { if (c.ready && !readyPool[twin].ready) readyPool[twin] = c; continue; }
      readyPool.push(c);
    }
    state.pool = readyPool;
    state.checkLoop = async c => { const f = await finalise(c, Date.now() + 9000); if (f) { f.cells = f.cells || cellsOf(f.pts); f.ready = true; if (f.ev.busy == null) f.ev.busy = c.ev.busy; } return f && f.repAfter < (f.quiet ? 300 : 200) ? f : null; };
    $("#mix").hidden = readyPool.length < 2;
    searchLayer.clearLayers(); bestLayer.clearLayers();
    say(`Found ${best.length} option${best.length === 1 ? "" : "s"} in ${((Date.now() - T0) / 1000).toFixed(0)} s`, false);
    renderResult();
    map.fitBounds(L.latLngBounds(best[0].pts.map(p => [p[0], p[1]])), { padding: [30, 30] });
    prog.finish(true);
    if (window.matchMedia("(max-width: 820px)").matches) $("#map").scrollIntoView({ behavior: "smooth" });
  } catch (e) {
    searchLayer.clearLayers(); bestLayer.clearLayers();
    say("Planning stopped", false);
    prog.finish(false, "Planning stopped");
    if (e.name === "AbortError") e.reason = "timeout";
    showMsg(e.name === "AbortError" ? "A service took too long to answer. Try again in a minute." : (e.message || String(e)));
    if (e.reason !== "input" && diag.on) showDiag(await diag.code(e).catch(() => null));
  } finally {
    go.disabled = false; go.textContent = "Plan my loop";
  }
}

/* Wiring */
restore();
if (!$("#when").value) $("#when").value = defaultWhen();
$("#distOut").textContent = $("#dist").value;
syncHourSlider();
$("#dist").addEventListener("input", e => { $("#distOut").textContent = e.target.value; if (state.wind) showWind(state.wind, new Date($("#when").value).getTime(), +e.target.value); });
$("#when").addEventListener("change", () => { syncHourSlider(); if (state.wind) showWind(state.wind, new Date($("#when").value).getTime(), +$("#dist").value); });
$("#whenSlider").addEventListener("input", e => setHour(+e.target.value));
$("#hours").addEventListener("click", e => { const i = e.target.closest("i[data-h]"); if (i) setHour(+i.dataset.h); });
["mixWind", "mixFsw", "mixTown"].forEach(id => { $("#" + id).addEventListener("input", () => applyMix(false)); $("#" + id).addEventListener("change", () => applyMix(true)); });
const profPos = e => { const r = $("#profSvg").getBoundingClientRect(); return Math.floor((e.clientX - r.left) / r.width * (state.prof ? state.prof.out.length : 1)); };
$("#profSvg").addEventListener("pointermove", e => profileCursor(profPos(e)));
$("#profSvg").addEventListener("pointerdown", e => profileCursor(profPos(e)));
$("#profSvg").addEventListener("pointerleave", profileLeave);
$("#form").addEventListener("submit", e => { e.preventDefault(); plan(); });

["cda", "power", "mass"].forEach(id => $("#" + id).addEventListener("input", drawRider));
drawRider();
$("#dist").addEventListener("change", () => { if (pinned) prefetchPop(pinned.lat, pinned.lon); });
$("#start").addEventListener("change", async () => { try { const s = await geocode($("#start").value); pinned = s; setStartMarker(s.lat, s.lon); map.setView([s.lat, s.lon], 11); refreshWind(s.lat, s.lon); prefetchData(s.lat, s.lon); } catch (e) {} });
map.on("click", e => {
  const lat = e.latlng.lat, lon = e.latlng.lng;
  pinned = { lat, lon, label: `${lat.toFixed(5)}, ${lon.toFixed(5)}` };
  $("#start").value = pinned.label; setStartMarker(lat, lon); refreshWind(lat, lon); prefetchData(lat, lon); save();
});
$("#locate").addEventListener("click", () => {
  if (!navigator.geolocation) return;
  navigator.geolocation.getCurrentPosition(p => {
    const lat = p.coords.latitude, lon = p.coords.longitude;
    pinned = { lat, lon, label: `${lat.toFixed(5)}, ${lon.toFixed(5)}` };
    $("#start").value = pinned.label; setStartMarker(lat, lon); map.setView([lat, lon], 12); refreshWind(lat, lon); prefetchData(lat, lon);
  }, () => showMsg("Couldn't get your location. Type a start or click the map."));
});
(async () => {
  try { const s = await geocode($("#start").value); pinned = s; setStartMarker(s.lat, s.lon); map.setView([s.lat, s.lon], 11); refreshWind(s.lat, s.lon); prefetchData(s.lat, s.lon); }
  catch (e) { $("#wMeta").textContent = "Set a start to see the wind."; }
})();
</script>
