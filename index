/* Wind on a single leg: tailwind-angle share, headwind share, longest headwind stretch, ride time. */
function legEval(pts, t0, wind, r) {
  let t = 0, len = 0, align = 0, head = 0, run = 0, maxRun = 0, runFrom = 0, worst = null;
  for (let i = 0; i < pts.length - 1; i++) {
    const a = pts[i], b = pts[i + 1], d = hav(a[0], a[1], b[0], b[1]);
    if (d < 0.5) continue;
    const bb = brg(a[0], a[1], b[0], b[1]), [ws, wd] = wind.at(t0 + t * 1000, a[0], a[1]);
    const c = windClass(ws, wd, bb, r.wfac), h = ws * r.wfac * Math.cos((wd - bb) * D2R);
