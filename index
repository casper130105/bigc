    s += `<rect x="${(b * bw).toFixed(1)}" y="${(v >= 0 ? mid - hgt : mid).toFixed(1)}" width="${(bw + .6).toFixed(1)}" height="${hgt.toFixed(1)}" fill="${col}"/>`;
  });
  s += `<line x1="0" y1="${mid}" x2="${W}" y2="${mid}" stroke="var(--line)"/>`;
  const tx = turnKm / (total / 1000) * W;
