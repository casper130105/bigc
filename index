<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Big C 2.0: wind optimizer</title>
<meta name="description" content="Big C 2.0 plans a road-bike loop over popular road-bike roads and fietssnelwegen, with headwind on the way out and tailwind home. Download it as GPX.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23a8413a'/%3E%3Cpath d='M6 12h14a4 4 0 1 0-4-4M6 18h18a4 4 0 1 1-4 4M6 24h8' fill='none' stroke='%23fff' stroke-width='2.6' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style>
/* Layout: a control panel beside a full-height map; on phones the panel stacks above the map. */
:root {
  --bg: #e9eeec;          /* polder mist */
  --panel: #f7f9f8;
  --ink: #15211e;
  --muted: #5a6a65;
  --line: #d2dbd8;
  --field: #ffffff;
  --accent: #a8413a;      /* fietspad red */
  --accent-ink: #ffffff;
  --wind: #1d3d57;        /* wind particles */
  --pop: #7651c2;         /* popular road-bike road */
  --fsw: #2a6ccc;         /* fietssnelweg */
  --bonus: #e0379b;       /* tailwind home on a fietssnelweg */
  --tail-strong: #0d7a5f;
  --tail: #39a585;
  --cross: #8c9893;
  --head: #e39a3b;
  --head-strong: #c5432b;
  --casing: #ffffff;
  --tile-filter: none;
  --f-display: "Barlow Condensed", "Arial Narrow", "Roboto Condensed", sans-serif;
  --f-body: "Barlow", "Segoe UI", system-ui, -apple-system, sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e1513; --panel: #141c1a; --ink: #e3ebe8; --muted: #93a39d; --line: #26322f;
    --field: #1b2522; --accent: #d9645a; --accent-ink: #1a0d0b; --pop: #a68ae8; --wind: #cfe4f2; --fsw: #6ea2f2; --bonus: #ff70c4;
    --tail-strong: #2fc497; --tail: #5fb79b; --cross: #7d8a85; --head: #e9a54e; --head-strong: #ef6a4f;
    --casing: #0e1513; --tile-filter: invert(1) hue-rotate(180deg) brightness(.92) contrast(.88) saturate(.7);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e1513; --panel: #141c1a; --ink: #e3ebe8; --muted: #93a39d; --line: #26322f;
  --field: #1b2522; --accent: #d9645a; --accent-ink: #1a0d0b; --pop: #a68ae8; --wind: #cfe4f2; --fsw: #6ea2f2; --bonus: #ff70c4;
  --tail-strong: #2fc497; --tail: #5fb79b; --cross: #7d8a85; --head: #e9a54e; --head-strong: #ef6a4f;
  --casing: #0e1513; --tile-filter: invert(1) hue-rotate(180deg) brightness(.92) contrast(.88) saturate(.7);
  color-scheme: dark;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }
html, body { height: 100%; margin: 0; }
body { background: var(--bg); color: var(--ink); font: 15px/1.5 var(--f-body); -webkit-font-smoothing: antialiased; }
.app { display: grid; grid-template-columns: minmax(340px, 430px) 1fr; height: 100%; }
.panel {
  background: var(--panel); border-right: 1px solid var(--line); overflow-y: auto;
  display: flex; flex-direction: column; gap: 22px;
  padding-block: max(20px, env(safe-area-inset-top, 0px)) max(24px, env(safe-area-inset-bottom, 0px));
  padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: 20px;
}
#map { height: 100%; min-height: 0; background: var(--bg); }
.leaflet-tile-pane { filter: var(--tile-filter); }
a { color: inherit; }
code { font-family: var(--f-mono); font-size: .85em; background: var(--bg); padding: 1px 5px; border-radius: 4px; word-break: break-all; }

header h1 { font: 700 2.4rem/1 var(--f-display); letter-spacing: .01em; margin: 0; display: flex; align-items: center; gap: 10px; text-transform: uppercase; }
header h1 svg { width: 34px; height: 34px; flex: none; }
header h1 span { display: flex; flex-direction: column; }
header h1 small { font: 600 .95rem/1.1 var(--f-display); letter-spacing: .14em; color: var(--accent); margin-top: 3px; }
header p { margin: 8px 0 0; color: var(--muted); max-width: 36ch; }
.wind-canvas { position: absolute; inset: 0; z-index: 450; pointer-events: none; }
.leaflet-control-layers { background: var(--panel) !important; color: var(--ink); border: 1px solid var(--line) !important; font: 500 13px var(--f-body); }
.leaflet-control-layers label { display: flex; align-items: center; gap: 6px; }

.label { display: block; font: 600 .78rem/1.2 var(--f-body); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
.field { display: flex; flex-direction: column; min-width: 0; }
.row { display: flex; gap: 8px; align-items: stretch; flex-wrap: wrap; }
.row > input { flex: 1; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
form { display: flex; flex-direction: column; gap: 16px; }
input[type=text], input[type=number], input[type=password], input[type=datetime-local] {
  width: 100%; min-width: 0; font: 500 1rem var(--f-body); color: var(--ink); background: var(--field);
  border: 1px solid var(--line); border-radius: 8px; padding: 9px 11px;
}
input:focus-visible, button:focus-visible, .seg label:has(input:focus-visible), summary:focus-visible, tr:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.hint { font-size: .85rem; color: var(--muted); margin-top: 5px; }
.icon-btn { flex: none; width: 42px; border: 1px solid var(--line); background: var(--field); color: var(--ink); border-radius: 8px; cursor: pointer; display: grid; place-items: center; }
.icon-btn:hover { border-color: var(--accent); color: var(--accent); }
.icon-btn svg { width: 20px; height: 20px; }

.dist { display: flex; align-items: baseline; gap: 6px; }
.dist output { font: 700 2rem/1 var(--f-display); font-variant-numeric: tabular-nums; }
.dist span { color: var(--muted); font-weight: 500; }
input[type=range] { width: 100%; accent-color: var(--accent); margin: 8px 0 0; }

.seg { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--field); }
.seg label { text-align: center; padding: 8px 4px; cursor: pointer; font-weight: 500; font-size: .92rem; border-left: 1px solid var(--line); }
.seg label:first-child { border-left: 0; }
.seg input { position: absolute; opacity: 0; pointer-events: none; }
.seg label:has(input:checked) { background: var(--ink); color: var(--panel); }

.prefs { display: flex; flex-direction: column; gap: 8px; }
.check { display: flex; align-items: center; gap: 9px; font-weight: 500; }
.check input { width: 18px; height: 18px; accent-color: var(--accent); flex: none; }
.swatch { width: 18px; height: 4px; border-radius: 2px; flex: none; }

details { border-top: 1px solid var(--line); padding-top: 12px; }
summary { cursor: pointer; font-weight: 600; color: var(--muted); list-style: none; display: flex; justify-content: space-between; gap: 10px; }
summary::-webkit-details-marker { display: none; }
summary::after { content: "+"; font-family: var(--f-mono); }
details[open] summary::after { content: "–"; }
details > .grid2, details > .inner { margin-top: 12px; }


.go { font: 700 1.25rem/1 var(--f-display); letter-spacing: .06em; text-transform: uppercase; background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 10px; padding: 15px; cursor: pointer; }
.go:hover { filter: brightness(1.07); }
.go:disabled { opacity: .55; cursor: progress; }
.go.small { font-size: 1rem; padding: 10px 14px; border-radius: 8px; }
.ghost { font: 600 .9rem var(--f-body); background: none; border: 1px solid var(--line); color: var(--ink); border-radius: 8px; padding: 9px 14px; cursor: pointer; }
.ghost:hover { border-color: var(--accent); }

/* Riding position */
.aero { border: 1px solid var(--line); border-radius: 12px; background: var(--field); padding: 8px 14px 12px 6px; display: flex; flex-direction: column; gap: 6px; }
.aero-top { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center; }
.aero-speed { font: 700 1.6rem/1 var(--f-display); font-variant-numeric: tabular-nums; }
.aero-controls { display: flex; flex-direction: column; gap: 8px; padding-left: 8px; }
.aero-row { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 10px; align-items: center; font: 600 .78rem var(--f-body); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.aero-row input[type=range] { margin: 0; }
.aero-power { display: flex; align-items: center; gap: 6px; font: 500 .95rem var(--f-body); letter-spacing: 0; text-transform: none; color: var(--muted); }
.aero-power input { width: 84px; padding: 6px 9px; }
.aero svg { width: 100%; height: auto; display: block; max-width: 260px; }
.aero-read { display: flex; flex-direction: column; gap: 2px; text-align: right; min-width: 0; max-width: 130px; }
.aero-name { font: 700 1.15rem/1.05 var(--f-display); text-transform: uppercase; letter-spacing: .02em; text-wrap: balance; }
.aero-cda { font-family: var(--f-mono); font-size: .85rem; color: var(--muted); }
.aero-cda b { color: var(--ink); font-weight: 500; }
.aero-ends { display: flex; justify-content: space-between; font: 600 .8rem var(--f-body); color: var(--muted); margin-left: 74px; }
@media (max-width: 420px) { .aero-top { grid-template-columns: 1fr; } .aero-read { text-align: left; max-width: none; } }

/* Wind card */
.wind { display: grid; grid-template-columns: 92px 1fr; gap: 14px; align-items: center; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--field); }
.wind svg { width: 92px; height: 92px; }
.wind .speed { font: 700 1.7rem/1 var(--f-display); font-variant-numeric: tabular-nums; }
.wind .meta { color: var(--muted); font-size: .9rem; }
.wind .advice { margin-top: 6px; font-weight: 600; }
#needle { transition: transform .6s cubic-bezier(.3,1.4,.5,1); transform-origin: 46px 46px; }
@media (prefers-reduced-motion: reduce) { #needle { transition: none; } }

/* Progress */
.steps:empty { display: none; }
.progress.ended .prog-top, .progress.ended .track { display: none; }
.steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: .93rem; }
.steps li { display: grid; grid-template-columns: 18px 1fr; gap: 8px; color: var(--muted); }
.steps li::before { content: ""; width: 10px; height: 10px; margin: 6px 4px; border-radius: 50%; border: 2px solid var(--line); }
.steps li[data-state=active] { color: var(--ink); }
.steps li[data-state=active]::before { border-color: var(--accent); border-top-color: transparent; animation: spin .8s linear infinite; }
.steps li[data-state=done]::before { background: var(--tail); border-color: var(--tail); }
.steps li[data-state=skip]::before { border-radius: 2px; height: 2px; margin-top: 10px; border-color: var(--muted); }
.steps li[data-state=error] { color: var(--head-strong); }
.steps li[data-state=error]::before { background: var(--head-strong); border-color: var(--head-strong); }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .steps li[data-state=active]::before { animation: none; border-top-color: var(--accent); } }

/* Progress bar */
.progress { display: flex; flex-direction: column; gap: 10px; }
.prog-top { display: flex; justify-content: space-between; gap: 12px; font-weight: 600; font-size: .95rem; }
.prog-num { font-family: var(--f-mono); font-weight: 500; font-size: .85rem; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
.track { height: 10px; border-radius: 5px; background: var(--line); overflow: hidden; }
.fill { height: 100%; width: 0; border-radius: 5px; background: linear-gradient(90deg, var(--head), var(--accent)); transition: width .3s ease; }
.progress.done .fill { background: var(--tail); }
@media (prefers-reduced-motion: reduce) { .fill { transition: none; } }

/* Live search */
.say { margin: 0; font: 600 1.05rem/1.35 var(--f-body); min-height: 2.7em; text-wrap: balance; }
.say.in { animation: sayIn .35s ease; }
@keyframes sayIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
@media (prefers-reduced-motion: reduce) { .say.in { animation: none; } }
/* Start-time strip */
.hours { display: flex; align-items: flex-end; gap: 1px; height: 34px; margin-top: 8px; cursor: pointer; }
.hours i { flex: 1; min-width: 0; background: var(--line); border-radius: 1px 1px 0 0; }
.hours i.night { opacity: .55; }
.hours i.day { box-shadow: -1px 0 0 var(--muted); }
.hours i.sel { background: var(--accent); opacity: 1; }
.when-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: center; }
.when-row input { margin: 2px 0 0; }
.when-row span { font: 500 .85rem var(--f-mono); color: var(--muted); white-space: nowrap; }
.map-say { background: var(--panel); color: var(--ink); border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; font: 600 13px/1.3 var(--f-body); max-width: 300px; box-shadow: 0 2px 10px rgba(0,0,0,.18); margin-right: 50px !important; }
/* Route chart */
.profile { margin: 4px 0 14px; display: flex; flex-direction: column; gap: 4px; }
.profile svg { width: 100%; height: 120px; display: block; background: var(--field); border: 1px solid var(--line); border-radius: 8px; touch-action: none; cursor: crosshair; }
.profile .pt { font: 500 10px var(--f-mono); fill: var(--muted); }
/* Priorities */
.mix { margin: 0 0 14px; }
.mix-body { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
.mix-row { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 10px; align-items: center; font: 600 .78rem var(--f-body); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.mix-row input { margin: 0; }

/* Results */
.result h2 { font: 700 1.5rem/1.1 var(--f-display); text-transform: uppercase; letter-spacing: .02em; margin: 0 0 12px; text-wrap: balance; }
.stats { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--line); }
.stat { padding: 10px 6px; border-left: 1px solid var(--line); }
.stat:first-child { border-left: 0; padding-left: 0; }
.stat b { display: block; font: 700 1.45rem/1.05 var(--f-display); font-variant-numeric: tabular-nums; }
.stat small { color: var(--muted); font-size: .74rem; text-transform: uppercase; letter-spacing: .07em; font-weight: 600; }
.halves { display: grid; gap: 8px; margin: 14px 0; }
.half { display: grid; grid-template-columns: 74px 1fr 44px; gap: 10px; align-items: center; font-size: .9rem; }
.half .bar { height: 10px; border-radius: 5px; overflow: hidden; display: flex; background: var(--line); }
.half .bar i { display: block; height: 100%; }
.half .pct { text-align: right; font-family: var(--f-mono); font-size: .85rem; }
.repeat { font-size: .9rem; font-weight: 600; display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
.repeat::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--tail); }
.repeat.warn::before { background: var(--head); }
.repeat.bonus { margin-top: -8px; }
.repeat.bonus::before { background: var(--bonus); }
.repeat.busy::before { background: var(--muted); }
.repeat.busy.warn::before { background: var(--head); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 16px; }
.chip { font-size: .84rem; padding: 3px 10px 3px 8px; border-radius: 99px; border: 1px solid var(--line); display: inline-flex; align-items: center; gap: 6px; max-width: 100%; }
.chip i { width: 10px; height: 3px; border-radius: 2px; flex: none; }
.chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dl { width: 100%; background: var(--ink); color: var(--panel); }
.opts { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); margin-bottom: 14px; }
.opts button { font: 600 .9rem/1.2 var(--f-body); color: var(--ink); background: none; border: 0; border-left: 1px solid var(--line); padding: 8px 6px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.opts button:first-child { border-left: 0; }
.opts button small { font: 500 .75rem var(--f-mono); color: var(--muted); }
.opts button[aria-selected="true"] { background: var(--ink); color: var(--panel); }
.opts button[aria-selected="true"] small { color: var(--panel); opacity: .75; }
.alts-wrap { overflow-x: auto; margin-top: 16px; }
.alts { width: 100%; border-collapse: collapse; font-size: .86rem; font-variant-numeric: tabular-nums; }
.alts th { text-align: left; font-weight: 600; color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; padding: 4px; border-bottom: 1px solid var(--line); white-space: nowrap; }
.alts td { padding: 6px 4px; border-bottom: 1px solid var(--line); white-space: nowrap; }
.alts tr.pick { cursor: pointer; }
.alts tr.pick:hover td { background: var(--bg); }
.alts tr.sel td { font-weight: 600; }
.alts tr.sel td:first-child { box-shadow: inset 3px 0 var(--accent); padding-left: 8px; }
.msg { font-size: .92rem; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--head-strong); color: var(--head-strong); }
.msg .diag { display: grid; grid-template-columns: 1fr auto; gap: 6px 8px; align-items: center; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--line); color: var(--muted); font-size: .8rem; }
.msg .diag span { grid-column: 1 / -1; }
.msg .diag code { font: .75rem var(--f-mono); color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 5px 7px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; user-select: all; -webkit-user-select: all; }
.msg .diag button { font: 600 .8rem/1.2 var(--f-body); color: var(--ink); background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; white-space: nowrap; cursor: pointer; }
.msg .diag button:hover { border-color: var(--ink); }
.note { font-size: .85rem; color: var(--muted); margin: 0; }
footer { margin-top: auto; font-size: .78rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 12px; }

/* Map extras */
.legend { background: var(--panel); color: var(--ink); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); font: 500 12px var(--f-body); display: grid; gap: 4px; }
.legend .ramp { width: 170px; height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--tail-strong), var(--tail), var(--cross), var(--head), var(--head-strong)); }
.legend .ends { display: flex; justify-content: space-between; color: var(--muted); }
.legend .key { display: flex; align-items: center; gap: 6px; }
.legend .key i { width: 18px; height: 3px; border-radius: 2px; }

@media (max-width: 820px) {
  html, body { height: auto; }
  .app { grid-template-columns: 1fr; height: auto; }
  .panel { border-right: 0; overflow: visible; padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-left: max(16px, env(safe-area-inset-left, 0px)); }
  #map { height: 70vh; }
  .stats { grid-template-columns: repeat(2, 1fr); }
  .stat:nth-child(3) { border-left: 0; padding-left: 0; }
  .stat:nth-child(n+3) { border-top: 1px solid var(--line); }
}
</style>
</head>
<body>
<div class="app">
  <aside class="panel">
    <header>
      <h1>
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="7" fill="var(--accent)"/><path d="M6 12h14a4 4 0 1 0-4-4M6 18h18a4 4 0 1 1-4 4M6 24h8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/></svg>
        <span>Big C 2.0<small>wind optimizer</small></span>
      </h1>
      <p>Headwind out, tailwind home.</p>
    </header>

    <form id="form" novalidate>
      <div class="field">
        <label class="label" for="start">Start</label>
        <div class="row">
          <input type="text" id="start" value="Groningen" autocomplete="off" placeholder="Address, town or lat,lon">
          <button type="button" class="icon-btn" id="locate" title="Use my location" aria-label="Use my location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
          </button>
        </div>
        <div class="hint">Or click the map.</div>
      </div>

      <div class="field">
        <label class="label" for="dist">Distance</label>
        <div class="dist"><output id="distOut">80</output><span>km</span></div>
        <input type="range" id="dist" min="20" max="200" step="5" value="80" aria-describedby="distOut">
      </div>

      <div class="field">
        <label class="label" for="when">Start time</label>
        <input type="datetime-local" id="when">
        <div class="hours" id="hours" aria-hidden="true"></div>
        <div class="when-row"><input type="range" id="whenSlider" min="0" max="72" step="1" value="0" aria-label="Start time in the next 72 hours"><span id="whenLbl">–</span></div>
