/* ===================================================== built-up areas (towns and villages)
   Every BRouter route reports, per stretch of road, its type, speed limit, street lighting and town class, and per
   point traffic lights, crossings and give-way junctions. From that Big C finds the built-up stretches itself:
   residential streets, 30/50 km/h limits and lit roads count as built-up, cycle paths don't; a ±300 m window smooths
   it and pieces closer than 300 m are merged. Each built-up piece is then matched to the nearest city, town or
   village in the built-in place list (all of the Netherlands, with population): cities and towns count fully,
   villages count a quarter. Outside the Netherlands a piece of 2 km or more, or with 3 traffic lights, counts as a
   town. Fietssnelwegen never count as built-up. */
function urbanScore(tags) {
  const hw = (tags.match(/(?:^| )highway=(\S+)/) || [])[1] || "", ms = (tags.match(/(?:^| )maxspeed=(\S+)/) || [])[1] || "";
  const lit = / lit=yes/.test(" " + tags), tc = (tags.match(/estimated_town_class=(\d)/) || [])[1] || "";
  if (hw === "cycleway") return 0;
  if (/^(residential|living_street|pedestrian|service)$/.test(hw) && (/^(30|20|15)$/.test(ms) || lit)) return 1;
  if (/^[456]$/.test(tc)) return 1;
  if (/^(30|20)$/.test(ms)) return 0.9;
  if (ms === "50") return 0.7;
  if (lit) return 0.5;
  if (tc === "3") return 0.5;
  if (/^(residential|living_street)$/.test(hw)) return 0.6;
  return 0;
}
/* seconds lost at a point: traffic light ≈15 s, crossing or give-way ≈4 s */
const stopDelay = nodeTags => /traffic_signals/.test(nodeTags) ? 15 : /crossing|give_way|stop/.test(nodeTags) ? 4 : 0;

let placeGrid = null;
function nearestPlace(lat, lon) {
  if (!placeGrid) {
    placeGrid = new Map();
    for (const p of NL_PLACES) { const k = Math.floor(p[0] * 20) + "," + Math.floor(p[1] * 20); if (!placeGrid.has(k)) placeGrid.set(k, []); placeGrid.get(k).push(p); }
  }
  const cy = Math.floor(lat * 20), cx = Math.floor(lon * 20);
  let best = null, bs = Infinity;
  for (let dy = -2; dy <= 2; dy++) for (let dx = -2; dx <= 2; dx++) for (const p of placeGrid.get((cy + dy) + "," + (cx + dx)) || []) {
    const big = p[2] === "c" || p[2] === "t" || p[3] >= 8000;
    const reach = p[2] === "c" ? 6000 : big ? 3500 : 1800;
    const d = hav(lat, lon, p[0], p[1]);
    if (d <= reach && d / reach < bs) { bs = d / reach; best = { name: p[4], town: big, d }; }
  }
  return best;
}
/* per point: 0 = open road, 1 = village, 2 = town or city */
function classifyBusy(P, fswIdx) {
  const n = P.length, cls = new Uint8Array(n);
  let known = 0; for (const p of P) if (p[3] != null) known++;
  if (n < 10 || known < 0.8 * n) return { known: false, cls, names: [] };
  const W = 20, pu = [0], ps = [0];
  for (const p of P) { pu.push(pu[pu.length - 1] + (p[3] || 0)); ps.push(ps[ps.length - 1] + ((p[4] || 0) >= 15 ? 1 : 0)); }
  const built = new Uint8Array(n);
  for (let i = 0; i < n; i++) { const a = Math.max(0, i - W), b = Math.min(n, i + W + 1); built[i] = ((pu[b] - pu[a]) / (b - a) + 0.25 * (ps[b] - ps[a])) >= 0.5 ? 1 : 0; }
  for (let i = 0; i < n;) { // merge gaps under 300 m
    if (built[i]) { i++; continue; }
    let j = i; while (j < n && !built[j]) j++;
    if (i > 0 && j < n && (j - i) * STEP < 300) built.fill(1, i, j);
    i = j;
  }
  const names = [];
  for (let i = 0; i < n;) {
    if (!built[i]) { i++; continue; }
    let j = i; while (j < n && built[j]) j++;
    const mid = P[(i + j) >> 1], pl = nearestPlace(mid[0], mid[1]), len = (j - i) * STEP, sig = ps[j] - ps[i];
    const c = pl ? (pl.town ? 2 : 1) : (len >= 2000 || sig >= 3 ? 2 : 1);
    cls.fill(c, i, j);
    if (pl && pl.name && len >= 300 && !names.includes(pl.name)) names.push(pl.name);
    i = j;
  }
  if (fswIdx && fswIdx.size) for (let i = 0; i < n; i++) if (cls[i] && inCellIndex(fswIdx, P[i][0], P[i][1])) cls[i] = 0;
  return { known: true, cls, names };
}

/* ===================================================== storage */
const store = {
  get(k, d = null) { try { const v = localStorage.getItem(k); return v == null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); return true; } catch (e) { return false; } },
