    if (c !== CLS_CALM) align += d * Math.cos(((bb - (wd + 180)) % 360 + 540) % 360 * D2R - Math.PI);
    if (c === CLS_HEAD) {
      if (run === 0) runFrom = i;
      head += d; run += d;
      if (run > maxRun) { maxRun = run; worst = pts[Math.floor((runFrom + i) / 2)]; } // middle of the worst headwind stretch
    } else run = 0;
  }
  return { len, align: align / Math.max(len, 1), headPct: 100 * head / Math.max(len, 1), maxRun, worst, time: t };
}

/* Way out: a half-ellipse from the start to T bulging to `side`, with `arc` metres of curve, its points kept away
   from the way home and snapped to popular roads that run along it. */
function outWaypoints(start, T, arc, side, m, pool, snapM, target, homeCells, quiet = false) {
  const c = hav(start[0], start[1], T[0], T[1]), base = brg(start[0], start[1], T[0], T[1]), a = c / 2;
  // Shape of the way out, in a frame with the start at (0, 0) and the turning point at (2a, 0):
  // normally half an ellipse over start–turning point, its bulge b solved so the half perimeter equals the wanted arc.
  // When the turning point is close (on a coast, the turning point is pulled back from the water) even the widest
  // half ellipse is too short; then the way out follows the long way round a circle through start and turning point.
  // The way home is a chord of that circle, so the loop stays round with a straight way home and nothing ridden twice.
  let lo = 0.2 * c, hi = 1.5 * a; // more bulge would put the middle of the way out farther away than the turning point
  let at; // at(t), t in 0..1 along the way out → [x, y]
  if (ellPer(a, hi) / 2 >= arc * 0.98) {
    if (ellPer(a, lo) / 2 >= arc) hi = lo;
    for (let k = 0; k < 40 && hi > lo; k++) { const mid = (lo + hi) / 2; if (ellPer(a, mid) / 2 < arc) lo = mid; else hi = mid; }
    const b = hi;
    at = t => [a - a * Math.cos(Math.PI * t), side * b * Math.sin(Math.PI * t)];
  } else {
    const len = R => R * (2 * Math.PI - 2 * Math.asin(Math.min(1, a / R))); // the long arc of a circle of radius R through both
    let rl = a, rh = Math.max(a * 2, arc / 3);
    for (let k = 0; k < 50; k++) { const mid = (rl + rh) / 2; if (len(mid) < arc) rl = mid; else rh = mid; }
    const R = rh, hc = Math.sqrt(Math.max(0, R * R - a * a)), cy = side * hc; // centre at (a, cy), on the outer side
    const f0 = Math.atan2(-cy, -a), sweep = len(R) / R; // from the start, round the far side, to the turning point
    const mid = d => cy + R * Math.sin(f0 + d * sweep / 2); // y halfway round, for either direction
    const dir = mid(1) * side > mid(-1) * side ? 1 : -1;    // go the way that passes the far side of the circle
    at = t => { const f = f0 + dir * sweep * t; return [a + R * Math.cos(f), cy + R * Math.sin(f)]; };
    m = Math.max(m, Math.min(9, Math.ceil(arc / 14000))); // a longer way out needs more waypoints to keep its shape
  }
  const wps = [], used = [], ids = new Set();
  for (let k = 1; k <= m; k++) {
    let [x, y] = at(k / (m + 1));
    let p = dest(start[0], start[1], base + Math.atan2(y, x) / D2R, Math.hypot(x, y));
    // keep the way out clear of the way home: push a point outwards while it sits in the home corridor
    for (let push = 0; push < 4 && homeCells && inCellIndex(homeCells, p[0], p[1], 600); push++) {
      y *= 1.3; p = dest(start[0], start[1], base + Math.atan2(y, x) / D2R, Math.hypot(x, y));
    }
    const pN = at((k + 0.5) / (m + 1)), pP = at((k - 0.5) / (m + 1));
    const tangent = norm(base + Math.atan2(pN[1] - pP[1], pN[0] - pP[0]) / D2R);
    if (quiet) { // quiet loops: a waypoint inside a town or village is moved just outside it, and not snapped to popular roads
      const pl = nearestPlace(p[0], p[1]);
      if (pl) { const src = NL_PLACES.find(q => q[4] === pl.name && hav(q[0], q[1], p[0], p[1]) === pl.d); if (src) { const away = brg(src[0], src[1], p[0], p[1]); p = dest(src[0], src[1], away, (pl.town ? 2600 : 1300)); } }
      wps.push({ lat: p[0], lon: p[1] });
      continue;
    }
    const snapped = snapToStretch(p, tangent, pool, ids, snapM, target, null, homeCells);
    if (snapped) { wps.push(...snapped.wps); used.push(snapped.it); }
    else wps.push({ lat: p[0], lon: p[1] });
  }
  return { wps, used };
}

/* Routing uses two free servers.
   BRouter (brouter.de, road-bike profile) answers "Please, retry later!" (HTTP 403) to more than about one request
   per second, so it gets a queue: one request at a time, at least 1.1 s apart, and a 403 means wait and retry.
   Requests that would otherwise wait go to the OpenStreetMap Germany bike router (OSRM), which takes parallel
   requests. If one server fails, the other is tried, so a busy server never ends the plan. */
const routeCache = new Map();
